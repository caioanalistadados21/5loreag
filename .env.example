# Opção recomendada para Render/Railway/Docker
GOOGLE_CALENDAR_ID=caioanalistadados@gmail.com

# Cole o JSON completo da Service Account em uma única variável.
# Em painéis que aceitam valor multilinha, pode colar o JSON exatamente como foi baixado.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"SEU_PROJECT_ID","private_key_id":"SEU_PRIVATE_KEY_ID","private_key":"-----BEGIN PRIVATE KEY-----\\nSUA_CHAVE\\n-----END PRIVATE KEY-----\\n","client_email":"SUA_SERVICE_ACCOUNT@SEU_PROJETO.iam.gserviceaccount.com","client_id":"SEU_CLIENT_ID","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"SUA_URL_X509","universe_domain":"googleapis.com"}

# Alternativa: variáveis separadas
# GOOGLE_PROJECT_ID=SEU_PROJECT_ID
# GOOGLE_CLIENT_EMAIL=SUA_SERVICE_ACCOUNT@SEU_PROJETO.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nSUA_CHAVE\\n-----END PRIVATE KEY-----\\n"
# GOOGLE_PRIVATE_KEY_ID=SEU_PRIVATE_KEY_ID
# GOOGLE_CLIENT_ID=SEU_CLIENT_ID
# GOOGLE_CLIENT_X509_CERT_URL=SUA_URL_X509
